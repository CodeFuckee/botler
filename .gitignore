# macOS
**/.DS_Store

# Python
__pycache__/
*.py[cod]
backend/.venv/
# CI 安全扫描专用 venv（security:deps-python / security:semgrep 各自独立，
# 避免并发写同一 venv 竞态；issue #86）
backend/.venv-audit/
backend/.venv-semgrep/
backend/.venv-lint/
backend/botler.db*
backend/config.yaml
backend/.env
# SSO 会话签名密钥（运行时自动生成，含密钥严禁入库）
backend/data/

# Node
frontend/node_modules/
frontend/dist/
# 构建时生成（scripts/gen-version.mjs 每次构建覆盖，含版本号与构建时间）
frontend/public/version.json

# 运行时数据（部署机器上生成，不入库）
# Docker 部署数据目录（默认 ./data，即 /home/ckd/codes/botler/data）
data/
workspace/
logs/
*.log
# 容器内 git 凭据（CI 部署生成，含 token，严禁入库）
.git-credentials
# dsh 引擎 SDK 默认会话目录（运行时产物，断点续跑数据应配 dsh.session_root 指向持久目录）
**/.sessions/
# CI 运行时 uv 缓存（部署机器生成，不入库）
cache/

# Playwright E2E 产物（issue #212）
frontend/playwright-report/
frontend/test-results/

# 覆盖率产物（issue #210：pytest-cov / c8 本地运行时生成，CI 以 artifact 上传，不入库）
.coverage
coverage.xml
htmlcov/
frontend/coverage/
