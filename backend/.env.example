# Botler 环境变量（复制为 .env，与 config.yaml 的 ${VAR} 引用配套）
# config.yaml 加载时会自动读取 .env（与 .env 同目录运行后端时）

# GitLab bot 账号 PAT（scope 至少 api + write_repository）
GITLAB_BOT_TOKEN=

# webhook 校验 secret（任意随机串，如 openssl rand -hex 32）
WEBHOOK_SECRET=

# ---- Claude Code 认证（DeepSeek 兼容端点，不登录 Anthropic）----
# ⚠️ 若服务器配置了代理，跑 claude -p 前需清理代理环境变量（否则报 TLS 证书错误）
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek-chat

# 可选：Claude Code 的权限 allowlist 目录（保持默认即可）
#CLAUDE_CONFIG_DIR=/root/.claude

# ---- MinIO 对象存储服务（issue #160）：后端部署附属服务，docker / pm2 两种形态共用 ----
# docker compose 部署：同名环境变量注入 compose（默认 minioadmin/minioadmin，
#   生产环境务必覆盖）；pm2 部署：CI 自动写入本文件供 pm2 配置读取（两者同源，
#   保持一致）。端口仅 docker 部署映射使用（pm2 形态固定 9000/9001）。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
#MINIO_API_PORT=9000
#MINIO_CONSOLE_PORT=9001
# ---- 识图图片上传 MinIO 的可选覆盖（issue #163/#164）：config.yaml minio 段
#      未显式配置时回退以下环境变量（endpoint / bucket / 公网前缀均有
#      默认值，通常无需设置；见 backend/config.example.yaml 的 minio 段）。
#      issue #164：OpenAI 兼容识图模型禁止 base64 内联，须启用 MinIO；
#      桶默认名 public（不存在自动创建并设为公开只读），后端已内置
#      /minio-public/ 访问端点（issue #319），MINIO_PUBLIC_BASE_URL 填
#      https://<站点>/minio-public 即可（nginx 代理为可选分流方案，
#      见 deploy/nginx-minio-public.conf）----
#MINIO_ENDPOINT=127.0.0.1:9000
#MINIO_BUCKET=public
#MINIO_PUBLIC_BASE_URL=https://<站点>/minio-public
