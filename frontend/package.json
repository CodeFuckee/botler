{
  "name": "botler-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:version": "node scripts/gen-version.mjs",
    "test": "node --test 'tests/**/*.test.mjs'",
    "build": "node scripts/gen-version.mjs && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "e2e:servers": "bash e2e/scripts/start-servers.sh",
    "test:coverage": "c8 --check-coverage --lines 70 --statements 70 --branches 60 --functions 50 --reporter=text --reporter=cobertura --include='src/**' node --test 'tests/**/*.test.mjs'"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^5.2.0",
    "c8": "^12.0.0",
    "react-test-renderer": "^18.3.1",
    "vite": "^7.3.6"
  }
}
